# 6. WebRTC 비디오 트랙
# ==========================================
class CameraTrack(VideoStreamTrack):
    kind = "video"

    async def recv(self):
        pts, time_base = await self.next_timestamp()
        with frame_lock:
            frame = latest_frame
        img = frame.copy() if frame is not None else np.zeros((480, 640, 3), dtype=np.uint8)

        with servo_lock:
            is_manual_now = manual_mode
        with detection_lock:
            detections = list(latest_detections)
            detection_time = latest_detection_time

        if is_manual_now:
            mode_text = "MANUAL"
            mode_color = (0, 165, 255)
        else:
            mode_text = "AUTO"
            mode_color = (0, 255, 0)
            cv2.line(img, (300, 240), (340, 240), (0, 255, 0), 2)
            cv2.line(img, (320, 220), (320, 260), (0, 255, 0), 2)

            # 오래된 박스가 최신 영상 위에 남지 않도록 짧게 만료시킨다.
            if time.monotonic() - detection_time <= 0.35:
                for label, conf, x1, y1, x2, y2, cx, cy in detections:
                    cv2.rectangle(img, (x1, y1), (x2, y2), (0, 0, 255), 2)
                    cv2.putText(
                        img,
                        f"{label} {conf:.2f}",
                        (x1, max(20, y1 - 10)),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.6,
                        (0, 0, 255),
                        2,
                    )
                    cv2.circle(img, (cx, cy), 5, (255, 0, 0), -1)

        cv2.putText(
            img,
            mode_text,
            (10, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.0,
            mode_color,
            2,
        )
        vf = VideoFrame.from_ndarray(img, format="bgr24")
        vf.pts, vf.time_base = pts, time_base
        return vf

