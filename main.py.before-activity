# 4. 카메라 프레임 읽기 스레드 (카메라 전환 대응)
# ==========================================
def read_frames():
    global latest_frame, exit_flag
    buffer    = b''
    last_proc = None
    while not exit_flag:
        proc = cam_process
        if proc is None:
            time.sleep(0.1)
            continue
        # 프로세스가 교체됐으면 버퍼 초기화
        if proc is not last_proc:
            buffer    = b''
            last_proc = proc
        chunk = proc.stdout.read(4096)
        if not chunk:
            if proc.poll() is not None:
                time.sleep(0.1)  # 전환 대기 (break 금지 — 새 cam_process 생길 때까지 루프 유지)
                buffer = b''
            else:
                time.sleep(0.01)
            continue
        buffer += chunk
        while True:
            s = buffer.find(b'\xff\xd8')
            if s == -1: break
            e = buffer.find(b'\xff\xd9', s + 2)
            if e == -1: break
            img = cv2.imdecode(np.frombuffer(buffer[s:e+2], np.uint8), cv2.IMREAD_COLOR)
            buffer = buffer[e+2:]
            if img is not None:
                with frame_lock:
                    latest_frame = img
        if len(buffer) > 10 * 1024 * 1024:
            buffer = b''

