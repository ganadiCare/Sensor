def light_monitor():
    night_count = 0
    day_count = 0

    while not exit_flag:
        if not _spi_ok:
            time.sleep(60)
            continue
        try:
            light_raw = read_light()
            print(
                f"[CDS] ADC={light_raw}  야간={is_night_mode}  "
                f"(야간기준>{NIGHT_THRESHOLD}, 주간기준<{DAY_THRESHOLD})"
            )

            night_count = night_count + 1 if light_raw > NIGHT_THRESHOLD else 0
            day_count = day_count + 1 if light_raw < DAY_THRESHOLD else 0

            # 한 번의 ADC 노이즈로 카메라가 바뀌지 않도록 3회 연속 확인한다.
            if not is_night_mode and night_count >= 3:
                print(f"[CDS] ADC {light_raw} 3회 연속 감지 → 야간 전환")
                switch_camera(night=True)
                night_count = day_count = 0
            elif is_night_mode and day_count >= 3:
                print(f"[CDS] ADC {light_raw} 3회 연속 감지 → 주간 복귀")
                switch_camera(night=False)
                night_count = day_count = 0
        except Exception as e:
            print(f"[CDS] 읽기 오류: {e}")
        time.sleep(3)  # 3초마다 체크

