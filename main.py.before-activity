# 7. WebRTC 연결 처리
# ==========================================
ICE_CONFIG = RTCConfiguration(iceServers=[
    RTCIceServer(
        urls=[
            f"turn:{TURN_HOST}:3478?transport=udp",
            f"turn:{TURN_HOST}:3478?transport=tcp"
        ],
        username=TURN_USER,
        credential=TURN_PASS
    ),
])

pcs = {}

async def handle_offer(session_id: str, sdp: str, ws):
    pc = RTCPeerConnection(configuration=ICE_CONFIG)
    pcs[session_id] = pc

    try:
        print(f"\n[WebRTC] Offer 처리 시작: {session_id}")

        pc.addTrack(CameraTrack())
        print("[WebRTC] CameraTrack 추가 완료")

        @pc.on("datachannel")
        def on_datachannel(channel):
            print(f"[WebRTC] DataChannel 수신: {channel.label}")

            @channel.on("message")
            def on_message(msg):
                try:
                    handle_control(json.loads(msg))
                except (json.JSONDecodeError, TypeError) as e:
                    print(f"[제어] 잘못된 DataChannel 메시지 무시: {e}")
                except Exception as e:
                    print(f"[제어] 메시지 처리 오류: {e}")

        @pc.on("connectionstatechange")
        async def on_state_change():
            print(f"[WebRTC] 연결 상태: {pc.connectionState}")

            if pc.connectionState in ("failed", "closed"):
                await pc.close()
                pcs.pop(session_id, None)

        @pc.on("iceconnectionstatechange")
        async def on_ice_state():
            print(f"[WebRTC] ICE 상태: {pc.iceConnectionState}")

        print("[1] setRemoteDescription 시작")
        await pc.setRemoteDescription(
            RTCSessionDescription(
                sdp=sdp,
                type="offer",
            )
        )
        print("[1] setRemoteDescription 성공")

        print("[2] createAnswer 시작")
        answer = await pc.createAnswer()
        print("[2] createAnswer 성공")

        print("[3] setLocalDescription 시작")
        await pc.setLocalDescription(answer)
        print("[3] setLocalDescription 성공")

        print("[4] Answer WebSocket 전송 시작")
        await ws.send(json.dumps({
            "type": "answer",
            "sdp": pc.localDescription.sdp,
            "sessionId": session_id,
        }))
        print(f"[4] Answer 전송 완료: {session_id}")

    except Exception as e:
        print("\n" + "=" * 60)
        print(f"[WebRTC ERROR] session={session_id}")
        print(f"[WebRTC ERROR] {type(e).__name__}: {e}")
        traceback.print_exc()
        print("=" * 60 + "\n")

        try:
            await pc.close()
        except Exception:
            pass

        pcs.pop(session_id, None)

