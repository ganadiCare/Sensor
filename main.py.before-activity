# 5. YOLO 추론 + AI 트래킹 스레드
# ==========================================
def calculate_auto_delta(error, deadzone, gain, max_step):
    """데드존 밖으로 벗어난 양에만 비례해 작은 자동 추적 각도를 계산한다."""
    excess = abs(error) - deadzone
    if excess <= 0:
        return 0.0
    delta = min(max_step, 0.35 + excess * gain)
    return math.copysign(delta, error)


def run_inference_and_track():
    global exit_flag, next_pan, next_tilt
    global latest_detections, latest_detection_time

    CENTER_X, CENTER_Y = 320, 240
    DEADZONE_X, DEADZONE_Y = 80, 60
    MAX_STEP_PAN, MAX_STEP_TILT = 1.25, 1.1
    PAN_GAIN, TILT_GAIN = 0.006, 0.006
    # 현재 yolo11n 처리 속도(약 12 FPS)보다 짧게 두어 매 추론 프레임마다
    # 보정할 수 있게 한다. 최대 속도는 수동 조작의 15도/초와 비슷하다.
    MOVE_COOLDOWN = 0.07

    smooth_cx, smooth_cy = float(CENTER_X), float(CENTER_Y)
    EMA_ALPHA = 0.45
    last_move_time = 0.0
    last_tracking_log = 0.0
    last_processed = None
    previous_target = None
    target_seen_frames = 0
    target_missed_frames = 0
    TARGET_CONFIRM_FRAMES = 2
    TARGET_FORGET_FRAMES = 4
    TARGET_SWITCH_DISTANCE = 180
    DIRECTION_CONFIRM_FRAMES = 2
    pan_direction = 0
    tilt_direction = 0
    pan_direction_frames = 0
    tilt_direction_frames = 0

    while not exit_flag:
        with servo_lock:
            is_manual_now = manual_mode

        if is_manual_now:
            with detection_lock:
                latest_detections = []
                latest_detection_time = 0.0
            time.sleep(0.03)
            last_processed = None
            smooth_cx, smooth_cy = float(CENTER_X), float(CENTER_Y)
            previous_target = None
            target_seen_frames = 0
            target_missed_frames = 0
            pan_direction = tilt_direction = 0
            pan_direction_frames = tilt_direction_frames = 0
            continue

        with frame_lock:
            frame = latest_frame
        if frame is None or frame is last_processed:
            time.sleep(0.01)
            continue
        last_processed = frame
        frame = frame.copy()

        results = model.predict(
            frame,
            classes=list(TARGET_CLASSES.keys()),
            conf=DETECTION_CONFIDENCE,
            imgsz=INFERENCE_SIZE,
            verbose=False,
        )

        centers = []
        detections = []
        for box in results[0].boxes:
            cls_id = int(box.cls[0])
            conf   = float(box.conf[0])
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            cx, cy = (x1+x2)//2, (y1+y2)//2
            centers.append((TARGET_CLASSES[cls_id], cx, cy, conf))
            detections.append(
                (TARGET_CLASSES[cls_id], conf, x1, y1, x2, y2, cx, cy)
            )

        with detection_lock:
            latest_detections = detections
            latest_detection_time = time.monotonic()

        if centers:
            # 이미 보고 있던 위치에 가장 가까운 대상을 우선해, 두 동물 사이를
            # 신뢰도 변화만으로 왕복하는 현상을 줄인다.
            if previous_target is None:
                _, cx, cy, _ = max(centers, key=lambda x: x[3])
                target_seen_frames = 1
            else:
                px, py = previous_target
                _, cx, cy, _ = min(
                    centers,
                    key=lambda x: (x[1] - px) ** 2 + (x[2] - py) ** 2,
                )
                target_jump = math.hypot(cx - px, cy - py)
                if target_jump > TARGET_SWITCH_DISTANCE:
                    # 기존 대상이 사라지고 먼 대상이 새로 잡힌 경우에는 다시
                    # 연속 프레임 확인을 거친 뒤 움직인다.
                    target_seen_frames = 1
                    smooth_cx, smooth_cy = float(cx), float(cy)
                else:
                    target_seen_frames += 1

            previous_target = (cx, cy)
            target_missed_frames = 0
            smooth_cx = EMA_ALPHA*cx + (1-EMA_ALPHA)*smooth_cx
            smooth_cy = EMA_ALPHA*cy + (1-EMA_ALPHA)*smooth_cy
            now = time.monotonic()

            ex, ey = CENTER_X - smooth_cx, CENTER_Y - smooth_cy
            pan_delta = calculate_auto_delta(
                ex, DEADZONE_X, PAN_GAIN, MAX_STEP_PAN
            )
            tilt_delta = calculate_auto_delta(
                -ey, DEADZONE_Y, TILT_GAIN, MAX_STEP_TILT
            )

            new_pan_direction = 0 if pan_delta == 0 else (1 if pan_delta > 0 else -1)
            if new_pan_direction == 0:
                pan_direction = 0
                pan_direction_frames = 0
            elif new_pan_direction == pan_direction:
                pan_direction_frames += 1
            else:
                pan_direction = new_pan_direction
                pan_direction_frames = 1

            new_tilt_direction = 0 if tilt_delta == 0 else (1 if tilt_delta > 0 else -1)
            if new_tilt_direction == 0:
                tilt_direction = 0
                tilt_direction_frames = 0
            elif new_tilt_direction == tilt_direction:
                tilt_direction_frames += 1
            else:
                tilt_direction = new_tilt_direction
                tilt_direction_frames = 1

            if target_seen_frames >= TARGET_CONFIRM_FRAMES and now - last_move_time >= MOVE_COOLDOWN:
                with servo_lock:
                    if not manual_mode and not servo_busy:
                        np_, nt_, moved = current_pan, current_tilt, False

                        if pan_direction_frames >= DIRECTION_CONFIRM_FRAMES:
                            np_ = max(55.0, min(155.0, current_pan + pan_delta))
                            moved = True

                        if tilt_direction_frames >= DIRECTION_CONFIRM_FRAMES:
                            nt_ = max(0.0, min(120.0, current_tilt + tilt_delta))
                            moved = True

                        if moved:
                            next_pan, next_tilt = np_, nt_
                            last_move_time = now
                            if now - last_tracking_log >= 0.5:
                                print(
                                    f"[추적] target=({cx},{cy}) "
                                    f"error=({ex:.0f},{ey:.0f}) "
                                    f"pan={current_pan:.1f}->{next_pan:.1f} "
                                    f"tilt={current_tilt:.1f}->{next_tilt:.1f}"
                                )
                                last_tracking_log = now
        else:
            target_missed_frames += 1
            if target_missed_frames >= TARGET_FORGET_FRAMES:
                smooth_cx, smooth_cy = float(CENTER_X), float(CENTER_Y)
                previous_target = None
                target_seen_frames = 0
                pan_direction = tilt_direction = 0
                pan_direction_frames = tilt_direction_frames = 0

# ==========================================
# 6. 수동 조작 처리
# ==========================================
def parse_direction(value):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    if not math.isfinite(number) or number not in (-1.0, 0.0, 1.0):
        return None
    return int(number)


def handle_control(msg):
    global manual_mode, next_pan, next_tilt
    global manual_pan_dir, manual_tilt_dir, manual_last_command, manual_centering

    if not isinstance(msg, dict):
        print(f"[제어] 객체가 아닌 메시지 무시: {type(msg).__name__}")
        return

    cmd = msg.get("cmd")

    if cmd == "mode":
        mode = msg.get("val")
        if mode not in ("manual", "auto"):
            print(f"[제어] 잘못된 모드 무시: {mode!r}")
            return

        with servo_lock:
            manual_mode = mode == "manual"
            manual_pan_dir = 0
            manual_tilt_dir = 0
            manual_centering = False
            # 어느 방향으로 모드를 바꾸더라도 이전 모드의 목표는 즉시 폐기한다.
            next_pan = current_pan
            next_tilt = current_tilt
        print(f"모드 변경: {'MANUAL' if manual_mode else 'AUTO'}")

    elif cmd == "move":
        pan_dir = parse_direction(msg.get("pan", 0))
        tilt_dir = parse_direction(msg.get("tilt", 0))
        if pan_dir is None or tilt_dir is None:
            print(f"[제어] 잘못된 방향값 무시: pan={msg.get('pan')!r}, tilt={msg.get('tilt')!r}")
            return

        direction_changed = False
        with servo_lock:
            if not manual_mode:
                return

            direction_changed = (
                pan_dir != manual_pan_dir
                or tilt_dir != manual_tilt_dir
                or manual_centering
            )
            manual_pan_dir = pan_dir
            manual_tilt_dir = tilt_dir
            manual_last_command = time.monotonic()
            manual_centering = pan_dir == 0 and tilt_dir == 0

        if direction_changed:
            print(f"[제어][MANUAL] direction pan={pan_dir} tilt={tilt_dir}")

    elif cmd == "stop":
        was_moving = False
        with servo_lock:
            was_moving = bool(
                manual_pan_dir or manual_tilt_dir or manual_centering
            )
            manual_pan_dir = 0
            manual_tilt_dir = 0
            manual_centering = False
            next_pan = current_pan
            next_tilt = current_tilt
        if was_moving:
            print("[제어][MANUAL] stop")

