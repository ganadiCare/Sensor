# ==========================================
# 3. 서보 워커 스레드
# ==========================================
STEP_DEG              = 2.0
STEP_SLEEP            = 0.04
IDLE_DETACH_DELAY     = 0.20
MANUAL_SPEED_DEG_SEC  = 15.0
MANUAL_COMMAND_TIMEOUT = 0.60

def run_servo_worker():
    global current_pan, current_tilt, next_pan, next_tilt, servo_busy
    global manual_pan_dir, manual_tilt_dir, manual_centering

    pan_attached = SERVO_HOLD_WHEN_IDLE
    tilt_attached = SERVO_HOLD_WHEN_IDLE
    last_motion_time = 0.0
    last_motion_log = 0.0

    while not exit_flag:
        now = time.monotonic()

        # 상태 계산부터 GPIO 출력까지 한 lock 안에서 처리한다. stop()이 반환된
        # 뒤 오래된 한 스텝이 다시 출력되는 경쟁 조건을 막기 위함이다.
        with servo_lock:
            if manual_mode:
                if (manual_pan_dir or manual_tilt_dir) and (
                    now - manual_last_command > MANUAL_COMMAND_TIMEOUT
                ):
                    print("[서보] 수동 명령 타임아웃 → 정지")
                    manual_pan_dir = 0
                    manual_tilt_dir = 0

                if manual_centering:
                    pan_delta = max(-STEP_DEG, min(STEP_DEG, 105.0 - current_pan))
                    tilt_delta = max(-STEP_DEG, min(STEP_DEG, 75.0 - current_tilt))
                    if abs(105.0 - current_pan) < 0.3 and abs(75.0 - current_tilt) < 0.3:
                        current_pan, current_tilt = 105.0, 75.0
                        manual_centering = False
                        pan_delta = tilt_delta = 0.0
                else:
                    manual_step = MANUAL_SPEED_DEG_SEC * STEP_SLEEP
                    pan_delta = manual_pan_dir * manual_step
                    tilt_delta = -manual_tilt_dir * manual_step

                next_pan = current_pan
                next_tilt = current_tilt
            else:
                pan_delta = max(-STEP_DEG, min(STEP_DEG, next_pan - current_pan))
                tilt_delta = max(-STEP_DEG, min(STEP_DEG, next_tilt - current_tilt))

            new_pan = max(55.0, min(155.0, current_pan + pan_delta))
            new_tilt = max(0.0, min(120.0, current_tilt + tilt_delta))
            pan_moved = abs(new_pan - current_pan) >= 0.01
            tilt_moved = abs(new_tilt - current_tilt) >= 0.01

            if pan_moved:
                current_pan = new_pan
                set_servo_angle(servo_pan, current_pan)
                pan_attached = True
            if tilt_moved:
                current_tilt = new_tilt
                set_servo_angle(servo_tilt, current_tilt)
                tilt_attached = True

            servo_busy = pan_moved or tilt_moved

            if servo_busy:
                last_motion_time = now
                if now - last_motion_log >= 0.5:
                    mode_label = "MANUAL" if manual_mode else "AUTO"
                    print(
                        f"[서보][{mode_label}] "
                        f"pan={current_pan:.1f} tilt={current_tilt:.1f}"
                    )
                    last_motion_log = now
            elif (
                not SERVO_HOLD_WHEN_IDLE
                and now - last_motion_time >= IDLE_DETACH_DELAY
            ):
                if pan_attached:
                    servo_pan.detach()
                    pan_attached = False
                if tilt_attached:
                    servo_tilt.detach()
                    tilt_attached = False

        time.sleep(STEP_SLEEP)

