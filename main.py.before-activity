SERVO_HOLD_WHEN_IDLE = os.getenv("SERVO_HOLD_WHEN_IDLE", "1") != "0"

def set_servo_angle(servo, angle):
    servo.value = (angle - 90) / 90.0

# 시작 시에는 어떤 각도도 출력하지 않는다. 명시적인 수동/자동 명령이 오기
