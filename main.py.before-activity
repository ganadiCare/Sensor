def read_light(samples: int = 9) -> int:
    """MCP3008 CH0을 여러 번 읽고 순간 노이즈를 제거한 중앙값을 반환한다."""
    values = []
    for _ in range(samples):
        adc = _spi.xfer2([1, (8 + 0) << 4, 0])
        values.append(((adc[1] & 3) << 8) + adc[2])
    return int(statistics.median(values))

