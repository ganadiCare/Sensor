def build_camera_cmd(night: bool) -> str:
    cam_idx = 0 if night else 1
    fps     = 15 if night else 30
    return (f'rpicam-vid --camera {cam_idx} --inline --nopreview -t 0 '
            f'--codec mjpeg --width 640 --height 480 --framerate {fps} -o -')

def switch_camera(night: bool):
    global cam_process, is_night_mode
    with cam_lock:
        if is_night_mode == night:
            return
        label = "야간(cam0)" if night else "주간(cam1)"
        print(f"[카메라] {label} 전환 중...")
        if cam_process:
            cam_process.terminate()
            try:
                cam_process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                cam_process.kill()
        cam_process   = subprocess.Popen(
            shlex.split(build_camera_cmd(night)),
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        is_night_mode = night
        print(f"[카메라] {label} 전환 완료")

